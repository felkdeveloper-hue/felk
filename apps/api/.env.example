# FE Platform — API environment template
# Copy to apps/api/.env and fill in values. Never commit real secrets.
# Frontend Vite vars belong in apps/web/.env only.

# ---------- General ----------
NODE_ENV=development
APP_NAME=fe-platform
APP_VERSION=0.1.0
API_PREFIX=/api/v1
API_DOCS_PATH=/api/docs
API_PUBLIC_URL=http://localhost:4000

# ---------- Server ----------
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SWAGGER_ENABLED=true
CSRF_ENABLED=false
METRICS_ENABLED=true
PRODUCTION_STRICT=false

# ---------- MongoDB ----------
MONGODB_URI=mongodb://localhost:27017/fe-platform
MONGODB_MAX_POOL_SIZE=10

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=fe:

# ---------- JWT / Cookies ----------
JWT_ACCESS_SECRET=dev-access-secret-change-me!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=dev-cookie-secret-change-me!!!
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---------- SMTP (Titan / Hostinger email) ----------
# Prefer 587 + STARTTLS locally (465 often times out with "Greeting never received").
# Titan: smtp.titan.email — TLS 587 (SMTP_SECURE=false) or SSL 465 (SMTP_SECURE=true)
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
EMAIL_FROM=noreply@yourdomain.com
EMAIL_PASSWORD="your-mailbox-password"
FROM_NAME=Fashion Edge
SHOP_URL=http://localhost:5173

# ---------- Optional local account seed ----------
LOCAL_ADMIN_PASSWORD=
LOCAL_CUSTOMER_EMAIL=
LOCAL_CUSTOMER_PASSWORD=

# ---------- Cloudflare R2 (preferred object storage) ----------
# When R2 credentials are set, uploads go to R2.
STORAGE_PROVIDER=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=felk-storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
CDN_BASE_URL=

# ---------- Cloudflare (optional) ----------
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---------- AWS S3 (alternative object storage) ----------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=fe-platform-assets
AWS_S3_ENDPOINT=
S3_PUBLIC_URL=

# ---------- Uploads ----------
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/avif

# ---------- Logging ----------
LOG_LEVEL=debug
MORGAN_FORMAT=dev
SHUTDOWN_TIMEOUT_MS=15000

# ---------- Payment Engine ----------
PAYMENT_RETURN_URL=http://localhost:5173/payment/return
PAYMENT_CANCEL_URL=http://localhost:5173/payment/cancel
PAYMENT_ATTEMPT_TTL_MINUTES=30
PAYMENT_MAX_RETRY_ATTEMPTS=5

PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
PAYHERE_NOTIFY_URL=

KOKO_MERCHANT_ID=
KOKO_SECRET_KEY=
KOKO_API_KEY=
# Prefer a .pem FILE path (never paste the key into PATH on production).
KOKO_PRIVATE_KEY_PATH=config/koko_private.pem
# Optional inline PEM (use \n inside double quotes). Do not commit real keys.
# KOKO_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
KOKO_PUBLIC_KEY=
KOKO_MODE=sandbox

MINTPAY_MERCHANT_ID=
MINTPAY_MERCHANT_SECRET=
MINTPAY_MODE=sandbox
# Public HTTPS origin when local return/cancel URLs are blocked by Mintpay WAF
MINTPAY_PUBLIC_ORIGIN=https://fe.lk
# Mintpay redirects here after pay (HMAC hash on query). Must be public HTTPS API.
MINTPAY_NOTIFY_URL=https://api.fe.lk/api/v1/payments/webhooks/mintpay
STOREFRONT_PUBLIC_URL=https://fe.lk
# PayHere live notify must be a public HTTPS API URL (not localhost)
PAYHERE_NOTIFY_URL=https://api.fe.lk/api/v1/payments/webhooks/payhere

COD_WEBHOOK_SECRET=

# ---------- FED Courier (Fardar Express Domestic) ----------
# Enable after adding credentials from the FED client portal → API section.
FED_ENABLED=false
FED_CLIENT_ID=
FED_API_KEY=
# Reverse API webhook URL (paste this into FED portal → Reverse API → Endpoint URL):
# ${API_PUBLIC_URL}${API_PREFIX}/integrations/fed/webhook

# ---------- Meta Conversions API ----------
META_CAPI_TOKEN=
META_PIXEL_ID=1485989443213075
# Optional — paste the Test Events code from Meta Events Manager while validating CAPI payloads.
# Must match the code shown in Events Manager (it changes). You can also open
# https://fe.lk/?test_event_code=TEST12345 so the browser sends the current code.
META_TEST_EVENT_CODE=

# ---------- Meta Marketing API (Ads Insights — reach, impressions, spend) ----------
# Server-side only. Never expose these to VITE_*. Token needs ads_read on the ad account.
META_ADS_ACCESS_TOKEN=
# Ad account id (with or without act_ prefix), e.g. act_1234567890
META_AD_ACCOUNT_ID=
META_ADS_SYNC_LOOKBACK_DAYS=30
META_ADS_SYNC_INTERVAL_HOURS=6

# Skip obvious bots/crawlers on analytics collect (recommended true).
ANALYTICS_BOT_FILTER=true

# ---------- TikTok Events API ----------
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# ---------- PostHog (optional — server-side capture) ----------
# Leave blank to disable server-side PostHog analytics capture.
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# Production sync checklist (localhost ↔ Vercel ↔ Render)
# =============================================================================
# 1) ONE MongoDB for everything:
#    - Local: MONGODB_URI = Atlas URI (never mongodb://localhost for shared catalog)
#    - Render API: same MONGODB_URI
#
# 2) Cloudflare R2 for all admin uploads:
#    - STORAGE_PROVIDER=r2 (or leave empty — API prefers R2 when keys exist)
#    - R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ACCOUNT_ID, R2_BUCKET_NAME
#    - R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#    - R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
#    - CDN_BASE_URL=same as R2_PUBLIC_URL
#
# 3) Render API env also needs:
#    - CORS_ORIGINS=https://your-web.vercel.app,http://localhost:5173
#
# 4) Vercel (apps/web) build env — set in apps/web/.env / Vercel dashboard:
#    - VITE_API_URL=https://your-api.onrender.com/api/v1
#    - VITE_CDN_URL=<same R2_PUBLIC_URL>

# FE Platform — storefront (Vite) environment
# Copy to apps/web/.env. These are the only frontend env vars.
# Backend secrets belong in apps/api/.env.

# Local (Vite proxy) or absolute API base — must end with /api/v1 in production:
VITE_API_URL=/api/v1
# VITE_API_URL=https://api.fe.lk/api/v1
VITE_APP_NAME=FE Platform
VITE_SITE_URL=http://localhost:5173
# Same as API R2_PUBLIC_URL — used to resolve /uploads/... media on the storefront
VITE_CDN_URL=
# Optional; production builds default to the API origin (https://api.fe.lk)
VITE_SOCKET_URL=

# PostHog — optional; analytics tracking is silently disabled when absent
# VITE_POSTHOG_KEY=phc_your_project_key
# VITE_POSTHOG_HOST=https://app.posthog.com

# Meta Pixel — browser-side tracking (defaults to FE.lk pixel when unset)
VITE_META_PIXEL_ID=1485989443213075
# Optional Test Events code. Prefer opening the shop with ?test_event_code=TEST12345
# so CAPI events appear in the same Meta Test Events window.
# VITE_META_TEST_EVENT_CODE=
